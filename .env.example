# Copy to .env (gitignored). docker-compose.yml reads it.

# Optional. The name on the pages when standalone (the admin page can also set it).
GAME_NAME=

# Optional. Leave empty to choose the staff password on /admin's first-run screen.
# Whoever completes setup first becomes admin, so do it right after deploying (or set this).
ADMIN_PASSWORD=

# Optional. Serve under a path behind your own proxy (it must strip the prefix), e.g. /leaderboard
BASE_PATH=

# Optional. Address and port on the host (default 127.0.0.1:3008).
BIND=
HOST_PORT=

# Optional. debug | info | warn | error (default info)
LOG_LEVEL=
