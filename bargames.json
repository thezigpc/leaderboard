{
  "id": "leaderboard",
  "name": "Leaderboard",
  "kind": "app",
  "version": "0.3.4",
  "image": "ghcr.io/thezigpc/leaderboard:0.3.4",
  "port": 3008,
  "sdk": {
    "version": "0.14.0",
    "level": 2
  },
  "routes": {
    "player": "/",
    "table": "/tv",
    "host": "/host",
    "admin": "/admin"
  },
  "routing": {
    "basePath": true
  },
  "health": "/health",
  "events": [
    "x-leaderboard-board-started",
    "x-leaderboard-result",
    "x-leaderboard-leader-changed",
    "x-leaderboard-board-finished",
    "winner",
    "game_result"
  ],
  "commands": [],
  "brandable": [
    "displayName",
    "tagline",
    "accent"
  ],
  "resources": {
    "memory": "256m",
    "cpus": 1
  },
  "network": {
    "internet": false
  },
  "env": {
    "DATA_DIR": "/data"
  }
}
